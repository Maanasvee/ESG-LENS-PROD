# ============================================================
# ESG Lens Backend — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_ENV=development
PIPELINE_SECRET=change-me-to-a-random-32-char-string

# ─── Database (SQLite local dev; PostgreSQL on Railway) ───────
DATABASE_URL=sqlite+aiosqlite:///./esglens.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eslens

# ─── Google Gemini ──────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
# Get from: https://aistudio.google.com/app/apikey

# ─── Groq (LLM Fallback) ────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
# Get from: https://console.groq.com/keys

# ─── ChromaDB ───────────────────────────────────────────────
# For Railway: ChromaDB runs in-process (persistent local dir)
CHROMA_PERSIST_DIR=./chroma_data
# If using external ChromaDB server (optional upgrade):
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# ─── Firebase Admin SDK (Backend) ───────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts
# → Generate New Private Key → download JSON
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR paste the JSON content directly as a string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Resend (Email Delivery) ─────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=eslens@yourdomain.com
# Get from: https://resend.com/api-keys
# Free tier: 3,000 emails/month

# ─── Frontend URL (for CORS) ────────────────────────────────
FRONTEND_URL=http://localhost:3000
# On production: https://eslens.bevolve.ai or your Vercel URL

# ─── Railway (set automatically on Railway deploy) ──────────
# PORT=8000
# RAILWAY_ENVIRONMENT=production
